      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"nvidia/nemotron-3-super-120b-a12b:free\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Ти — оператор першої лінії підтримки сервісу доставки їжі «Смачно».\\nЩодня ми отримуємо близько 300 звернень у чаті та на пошті, які потрібно\\nрозподілити і направити до різних підрозділів підтримки.\\n\\nКласифікуй звернення клієнта.\\n\\nПоверни ТІЛЬКИ валідний JSON. Без жодного тексту до або після. Без markdown-обгортки.\\n\\nСтруктура:\\n{\\n  \\\"topic\\\": \\\"...\\\",\\n  \\\"priority\\\": \\\"...\\\",\\n  \\\"needs_human\\\": ...,\\n  \\\"summary\\\": \\\"...\\\"\\n}\\n\\nДопустимі значення:\\n- topic: рівно одне з \\\"замовлення\\\", \\\"оплата\\\", \\\"якість їжі\\\", \\\"доставка\\\", \\\"інше\\\"\\n- priority: рівно одне з \\\"низький\\\", \\\"середній\\\", \\\"високий\\\"\\n- needs_human: тільки true або false\\n- summary: один рядок, максимум 15 слів\\n\\nПриклади:\\n\\nЗвернення: \\\"З картки списалось двічі за одне замовлення, 480 грн. Поверніть гроші!\\\"\\n{\\\"topic\\\":\\\"оплата\\\",\\\"priority\\\":\\\"високий\\\",\\\"needs_human\\\":true,\\\"summary\\\":\\\"Подвійне списання 480 грн, клієнт вимагає повернення\\\"}\\n\\nЗвернення: \\\"Доброго дня, а ви працюєте в неділю?\\\"\\n{\\\"topic\\\":\\\"інше\\\",\\\"priority\\\":\\\"низький\\\",\\\"needs_human\\\":false,\\\"summary\\\":\\\"Питання про графік роботи\\\"}\\n\\nЗвернення: \\\"Дуже смачно, дякую! До речі, промокод на наступне замовлення не спрацював.\\\"\\n{\\\"topic\\\":\\\"оплата\\\",\\\"priority\\\":\\\"середній\\\",\\\"needs_human\\\":false,\\\"summary\\\":\\\"Промокод не спрацював, відгук загалом позитивний\\\"}\\n\\nЗвернення: \\\"Привіт\\\"\\n{\\\"topic\\\":\\\"інше\\\",\\\"priority\\\":\\\"низький\\\",\\\"needs_human\\\":false,\\\"summary\\\":\\\"Звернення без змісту, потрібне уточнення\\\"}\\n\\nТепер класифікуй:\\nЗвернення: {{ $json.ticket }}\"\n    }\n  ]\n}",
        "options": {}
